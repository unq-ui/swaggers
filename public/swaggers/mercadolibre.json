{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "MercadoLibre API",
    "descrtiption": "API for MercadoLibre"
  },
  "servers": [
    {
      "url": "http://localhost:7070"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "QuestionAnswerBody": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "CartBody": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "PaymentBody": {
        "type": "object",
        "properties": {
          "cardNumber": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cvv": {
            "type": "string"
          },
          "expirationDate": {
            "type": "string"
          }
        }
      },
      "NewProductBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stock": {
            "type": "number"
          },
          "characteristics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "categoryId": {
            "type": "string"
          },
          "shipping": {
            "type": "object",
            "properties": {
              "price": {
                "type": "number"
              }
            }
          }
        }
      },
      "SimpleUserDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "CategoryDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ShippingDTO": {
        "type": "object",
        "properties": {
          "price": {
            "type": "number"
          }
        }
      },
      "PaymentDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cardNumber": {
            "type": "string"
          }
        }
      },
      "SimpleProductDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/SimpleUserDTO"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDTO"
          },
          "price": {
            "type": "number"
          },
          "shipping": {
            "$ref": "#/components/schemas/ShippingDTO"
          }
        }
      },
      "ItemDTO": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/SimpleProductDTO"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "PurchaseHistoryDTO": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDTO"
            }
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentDTO"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SaleHistoryDTO": {
        "type": "object",
        "properties": {
          "product": {
            "$ref": "#/components/schemas/SimpleProductDTO"
          },
          "amount": {
            "type": "number"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentDTO"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/SimpleUserDTO"
          }
        }
      },
      "UserDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "purchaseHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseHistoryDTO"
            }
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimpleProductDTO"
            }
          },
          "likedProducts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimpleProductDTO"
            }
          },
          "salesHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleHistoryDTO"
            }
          }
        }
      },
      "QuestionDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "product": {
            "$ref": "#/components/schemas/SimpleProductDTO"
          },
          "user": {
            "$ref": "#/components/schemas/SimpleUserDTO"
          },
          "text": {
            "type": "string"
          },
          "response": {
            "type": "string"
          }
        }
      },
      "ProductDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/SimpleUserDTO"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDTO"
          },
          "price": {
            "type": "number"
          },
          "shipping": {
            "$ref": "#/components/schemas/ShippingDTO"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionDTO"
            }
          }
        }
      },
      "ProductPageDTO": {
        "type": "object",
        "properties": {
          "amountOfPages": {
            "type": "number"
          },
          "currentPage": {
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimpleProductDTO"
            }
          },
          "amountOfElements": {
            "type": "number"
          }
        }
      },
      "CartDTO": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SimpleUserDTO"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemDTO"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "Get logged user profile",
        "description": "Retrieve the profile of the currently authenticated user",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - User not authenticated"
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "summary": "Get user by ID",
        "description": "Retrieve user information by user ID",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The user ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleUserDTO"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/{userId}/products": {
      "get": {
        "summary": "Get products by user",
        "description": "Retrieve all products listed by a specific user",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The user ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Products retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageDTO"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search products",
        "description": "Search for products in MercadoLibre",
        "tags": [
          "Search"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Search query"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "required": false,
            "description": "Page number for search results"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search results. If no products match the query, the response is still valid and `items` may be an empty array.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or invalid query"
          }
        }
      }
    },
    "/purchase": {
      "post": {
        "summary": "Create a new purchase",
        "description": "Creates a new purchase for an authenticated user",
        "tags": [
          "Purchase"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Purchase created successfully"
          },
          "400": {
            "description": "Invalid request data or Cart is empty"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Get all products",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "Page number to fetch. Defaults to 1 when not provided.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of all products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageDTO"
                }
              }
            }
          },
          "400": {
            "description": "Not valid page"
          }
        }
      },
      "post": {
        "summary": "Create a new product",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProductBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data."
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/products/{productId}": {
      "get": {
        "summary": "Get a specific product",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDTO"
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          }
        }
      },
      "put": {
        "summary": "Update a product",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProductBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data."
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/products/{productId}/related": {
      "get": {
        "summary": "Get related products",
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of related products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SimpleProductDTO"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/products/{productId}/like": {
      "put": {
        "summary": "Update product like status",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Like status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDTO"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/products/{productId}/question": {
      "post": {
        "summary": "Add a question to a product",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionAnswerBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDTO"
                }
              }
            }
          },
          "400": {
            "description": "The product owner cannot make questions or invalid data."
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/products/{productId}/question/{questionId}": {
      "put": {
        "summary": "Answer a product question",
        "tags": [
          "Products"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionAnswerBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not allowed"
          },
          "404": {
            "description": "Product or question not found"
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Get all categories",
        "description": "Retrieves a list of all available categories",
        "tags": [
          "Categories"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/categories/{categoryId}": {
      "get": {
        "summary": "Get category by ID",
        "description": "Retrieves a specific category by its ID",
        "tags": [
          "Categories"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "categoryId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The category ID"
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number (default is 1)"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a product page from the category.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPageDTO"
                }
              }
            }
          },
          "404": {
            "description": "Category not found or Invalid page"
          }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get user cart",
        "tags": [
          "Cart"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cart retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "summary": "Update user cart",
        "tags": [
          "Cart"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cart updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data."
          },
          "401": {
            "description": "Unauthorized."
          },
          "404": {
            "description": "Product not found."
          }
        }
      }
    },
    "/cart/{productId}": {
      "delete": {
        "summary": "Delete product from cart",
        "tags": [
          "Cart"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product ID to remove from cart"
          }
        ],
        "responses": {
          "200": {
            "description": "Product removed from cart successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartDTO"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The logged user",
            "headers": {
              "Authorization": {
                "description": "Bearer token for authenticated requests",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
